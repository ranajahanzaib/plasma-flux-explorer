# Optional override for `pnpm data:publish`; credentials are managed by Wrangler.
# When CF_ENV=staging/production, the matching bucket name is selected automatically.
# PFE_R2_BUCKET=plasma-flux-explorer-data

# Select a Wrangler environment when publishing catalog artifacts.
# CF_ENV=staging
# PFE_R2_LOCAL=1 uses Wrangler's local R2 emulator; it never targets the remote account.
